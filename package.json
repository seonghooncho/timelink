{
  "name": "timelink",
  "private": true,
  "workspaces": [
    "fe"
  ],
  "scripts": {
    "dev": "npm --workspace fe run dev",
    "build": "npm --workspace fe run build",
    "build:dev": "npm --workspace fe run build:dev",
    "lint": "npm --workspace fe run lint",
    "preview": "npm --workspace fe run preview",
    "test": "npm --workspace fe run test",
    "test:watch": "npm --workspace fe run test:watch",
    "fe:dev": "npm --workspace fe run dev",
    "fe:build": "npm --workspace fe run build",
    "fe:build:dev": "npm --workspace fe run build:dev",
    "fe:lint": "npm --workspace fe run lint",
    "fe:preview": "npm --workspace fe run preview",
    "fe:test": "npm --workspace fe run test",
    "fe:test:watch": "npm --workspace fe run test:watch",
    "test:playwright": "playwright test --config test/playwright/playwright.config.ts",
    "test:k6": "k6 run test/k6/timelink-load-test.js",
    "test:cleanup-load": "node test/scripts/cleanup-load-test.mjs",
    "test:aws-metrics": "node test/scripts/collect-aws-metrics.mjs",
    "mobile:start": "npm --prefix mobile run start",
    "mobile:typecheck": "npm --prefix mobile run typecheck",
    "mobile:prebuild:android": "npm --prefix mobile run prebuild:android",
    "mobile:prebuild:ios": "npm --prefix mobile run prebuild:ios",
    "mobile:export:web": "npm --prefix mobile run export:web",
    "mobile:build:android-release": "bin/mobile-build-android-release.sh",
    "ops:backfill-metadata": "node scripts/ops/backfill-dynamodb-metadata.mjs",
    "backend:run": "cd backend && ./gradlew bootRun",
    "backend:test": "cd backend && ./gradlew test",
    "ai:run": "cd ai && uvicorn app.main:app --reload --port 8000",
    "infra:init:fmt": "cd infra/terraform/init && terraform fmt -recursive",
    "infra:init:validate": "cd infra/terraform/init && terraform validate",
    "infra:fmt": "cd infra/terraform && terraform fmt -recursive",
    "infra:validate": "cd infra/terraform/minimum && terraform validate",
    "infra:cloudflare:fmt": "cd infra/terraform/cloudflare_free && terraform fmt -recursive",
    "infra:cloudflare:validate": "cd infra/terraform/cloudflare_free && terraform validate"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0"
  }
}
